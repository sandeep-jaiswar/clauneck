    {
      "name": "Error Cases - Input Validation",
      "item": [
        {
          "name": "Empty Query",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error response has correct structure', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('code').eql('TRANSLATION_FAILED');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('details');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"\"\n}"
            },
            "url": {
              "raw": "{{web_url}}/api/prototype",
              "host": [
                "{{web_url}}"
              ],
              "path": [
                "api",
                "prototype"
              ]
            },
            "description": "Should return 400: Query must not be empty"
          },
          "response": []
        },
        {
          "name": "Query Too Long (>1000 chars)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message mentions character limit', function () {",
                  "    var response = pm.response.text();",
                  "    pm.expect(response).to.include('1000');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"A projectile is launched with a very long and completely unnecessary description that goes on and on and on and never stops and keeps adding more and more irrelevant details about the projectile motion problem that we are trying to solve. The projectile is launched at an angle and we want to know many things about its motion including the trajectory the maximum height the range the time of flight and many other parameters. We also need to consider air resistance and drag forces and the rotation of the projectile and relativistic effects even though they don't matter for this problem. Additionally we should consider the curvature of the earth and gravitational variations and quantum mechanical uncertainty principles which are completely absurd for this macroscopic classical mechanics problem. Furthermore we want to add even more unnecessary constraints and boundary conditions that make no physical sense whatsoever. This query is intentionally designed to exceed the maximum allowed length of 1000 characters to test the input validation logic of the system.\"\n}"
            },
            "url": {
              "raw": "{{web_url}}/api/prototype",
              "host": [
                "{{web_url}}"
              ],
              "path": [
                "api",
                "prototype"
              ]
            },
            "description": "Should return 400: Query exceeds 1000 characters"
          },
          "response": []
        },
        {
          "name": "Null Query",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": null\n}"
            },
            "url": {
              "raw": "{{web_url}}/api/prototype",
              "host": [
                "{{web_url}}"
              ],
              "path": [
                "api",
                "prototype"
              ]
            },
            "description": "Should return 400: Query must not be empty"
          },
          "response": []
        }
      ]
    },
    {
