    {
      "name": "Happy Path - Projectile Motion",
      "item": [
        {
          "name": "1. Simple Projectile - 45° Launch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has model and result', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('model');",
                  "    pm.expect(jsonData).to.have.property('result');",
                  "    pm.expect(jsonData).to.have.property('message').eql('OK');",
                  "});",
                  "",
                  "pm.test('Model has required fields', function () {",
                  "    var model = pm.response.json().model;",
                  "    pm.expect(model).to.have.property('domain').eql('physics.mechanics');",
                  "    pm.expect(model).to.have.property('quantities');",
                  "    pm.expect(model).to.have.property('equations');",
                  "    pm.expect(model).to.have.property('initialConditions');",
                  "});",
                  "",
                  "pm.test('Result is successful with trajectory', function () {",
                  "    var result = pm.response.json().result;",
                  "    pm.expect(result).to.have.property('success').eql(true);",
                  "    pm.expect(result).to.have.property('trajectory');",
                  "    pm.expect(result.trajectory).to.have.property('time');",
                  "    pm.expect(result.trajectory).to.have.property('x');",
                  "    pm.expect(result.trajectory).to.have.property('y');",
                  "});",
                  "",
                  "pm.test('Trajectory has data points', function () {",
                  "    var trajectory = pm.response.json().result.trajectory;",
                  "    pm.expect(trajectory.time.length).to.be.greaterThan(0);",
                  "    pm.expect(trajectory.x.length).to.equal(trajectory.time.length);",
                  "    pm.expect(trajectory.y.length).to.equal(trajectory.time.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"A projectile is launched at 45 degrees with initial velocity 20 m/s. How far does it travel horizontally?\"\n}"
            },
            "url": {
              "raw": "{{web_url}}/api/prototype",
              "host": [
                "{{web_url}}"
              ],
              "path": [
                "api",
                "prototype"
              ]
            },
            "description": "Complete flow: translate natural language → validate → solve projectile motion"
          },
          "response": []
        },
