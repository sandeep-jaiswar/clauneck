    {
      "name": "Direct Engine Testing",
      "item": [
        {
          "name": "Engine Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{engine_url}}/health",
              "host": [
                "{{engine_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if Python FastAPI engine is ready"
          },
          "response": []
        },
        {
          "name": "Direct Engine Solve (Raw Model)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Result has success and trajectory', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success').eql(true);",
                  "    pm.expect(jsonData).to.have.property('trajectory');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"physics.mechanics\",\n  \"description\": \"Direct engine test: 45° projectile\",\n  \"quantities\": [\n    {\n      \"name\": \"v0\",\n      \"description\": \"Initial velocity\",\n      \"value\": 20.0,\n      \"siUnit\": \"m/s\",\n      \"isKnown\": true,\n      \"dimensionVector\": {\n        \"length\": 1,\n        \"time\": -1\n      }\n    },\n    {\n      \"name\": \"theta\",\n      \"description\": \"Launch angle\",\n      \"value\": 45.0,\n      \"siUnit\": \"deg\",\n      \"isKnown\": true,\n      \"dimensionVector\": {}\n    },\n    {\n      \"name\": \"g\",\n      \"description\": \"Gravitational acceleration\",\n      \"value\": 9.81,\n      \"siUnit\": \"m/s^2\",\n      \"isKnown\": true,\n      \"dimensionVector\": {\n        \"length\": 1,\n        \"time\": -2\n      }\n    },\n    {\n      \"name\": \"x\",\n      \"description\": \"Horizontal distance\",\n      \"isKnown\": false,\n      \"dimensionVector\": {\n        \"length\": 1\n      }\n    },\n    {\n      \"name\": \"y\",\n      \"description\": \"Vertical height\",\n      \"isKnown\": false,\n      \"dimensionVector\": {\n        \"length\": 1\n      }\n    }\n  ],\n  \"equations\": [\n    {\n      \"lhs\": \"x\",\n      \"rhs\": \"v0 * cos(theta * pi / 180) * t\",\n      \"type\": \"algebraic\",\n      \"description\": \"Horizontal position\"\n    },\n    {\n      \"lhs\": \"y\",\n      \"rhs\": \"v0 * sin(theta * pi / 180) * t - 0.5 * g * t**2\",\n      \"type\": \"algebraic\",\n      \"description\": \"Vertical position\"\n    }\n  ],\n  \"initialConditions\": {\n    \"t\": 0.0,\n    \"x\": 0.0,\n    \"y\": 0.0\n  },\n  \"solver\": {\n    \"method\": \"RK45\",\n    \"tolerance\": 1e-6,\n    \"timeSpan\": {\n      \"start\": 0.0,\n      \"end\": 3.0,\n      \"numPoints\": 100\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{engine_url}}/api/solve",
              "host": [
                "{{engine_url}}"
              ],
              "path": [
                "api",
                "solve"
              ]
            },
            "description": "Bypass translator; send complete model directly to Python solver. Validates engine independently."
          },
          "response": []
        }
      ]
    }
  ],
