                  "",
                  "pm.test('Error code is DOMAIN_NOT_SUPPORTED', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('code').eql('DOMAIN_NOT_SUPPORTED');",
                  "});"
